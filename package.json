{
  "name": "bitebook",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "tests/*",
    "infra",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.14",
    "@vitest/coverage-v8": "^5.0.5",
    "expo-router": "58.0.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "mobile": "npm run start --workspace @bitebook/mobile",
    "test": "bash scripts/run-with-project-node.sh bash scripts/run-tests.sh",
    "test:pipeline-isolation": "bash scripts/tests/check-pipeline-change-isolation.test.sh",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
