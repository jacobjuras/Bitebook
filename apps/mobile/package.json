{
  "name": "@bitebook/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost",
    "android": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost --android",
    "android:build": "expo run:android --no-bundler",
    "doctor": "expo-doctor",
    "ios": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost --ios",
    "ios:build": "expo run:ios --no-bundler",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@bitebook/domain": "0.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.22.2",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  },
  "private": true,
  "type": "module"
}
