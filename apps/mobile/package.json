{
  "name": "@bitebook/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
    "android": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --android",
